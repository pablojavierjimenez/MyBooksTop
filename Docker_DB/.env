#############################################
#          DOCKER MARIADB CONFIG
#############################################
# Configuración de MariaDB Docker Environment
MARIADB_USER_NAME=adminUser
MARIADB_USER_PASSWORD=adminPass
MARIADB_DATABASE_NAME=my-book-top
MARIADB_ROOT_USER_NAME=root
MARIADB_ROOT_PASSWORD=rootPass

# MariaDB
DK_MARIADB_CONTAINER_NAME=MBT_MariaDB
DK_MARIADB_HOST_PORT=3306

# --- PhpMyAdmin - Web Client ---
# Puertos de exposición al host desde el Docker Container
PHPMYADMIN_HOST_PORT=8082
DB_HOST_URL=localhost
### -----------------------------------------

#############################################
#        NestJS / TypeORM- Web Client        
#############################################
# Configuración adicional
DB_HOST=localhost
DB_PORT=3306
DB_SYNC=false
DB_LOGGING=true

# Configuración adicional TypeORM
DB_LOGGING=true
TYPEORM_SYNCHRONIZE=true
TYPEORM_AUTOLOAD_ENTITIES=true
### -----------------------------------------